{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": "Haggle",
  "tagline": "The shopper has an agent. Now your store does too.",
  "descriptor": "the merchant's counter-agent",
  "color": {
    "cream": { "value": "#FBF6EE", "role": "page background" },
    "cream-2": { "value": "#F3EBDD", "role": "secondary fill / chips" },
    "paper": { "value": "#FFFDF8", "role": "cards on cream" },
    "ink": { "value": "#1F1B16", "role": "primary text; dark surfaces" },
    "ink-2": { "value": "#4A433B", "role": "body text" },
    "ink-3": { "value": "#8A8178", "role": "muted labels" },
    "line": { "value": "#E6DCCB", "role": "borders" },
    "marigold": { "value": "#F2A33A", "role": "brand accent, CTA fill, Concierge" },
    "marigold-2": { "value": "#FFD58A", "role": "marigold tint" },
    "terracotta": { "value": "#D96B4A", "role": "emphasis, Pricing Critic, Butlr" },
    "sage": { "value": "#6E8B6B", "role": "Inventory, ZooWork, ZooData" },
    "sage-2": { "value": "#DBE6D8", "role": "sage tint" },
    "sky": { "value": "#3F7D9C", "role": "Scout, TinyFish, REPLAY badge" },
    "plum": { "value": "#9B6BB5", "role": "Bundler, Moss" },
    "indigo": { "value": "#5B6CF0", "role": "shopper side: Muse, Stripe(test)" },
    "indigo-2": { "value": "#E4E7FF", "role": "indigo tint" },
    "success": { "value": "#2F8F5B", "role": "approved, closed, LIVE" },
    "danger": { "value": "#C2402E", "role": "errors" },
    "dark-card": { "value": "#2B2620", "role": "cards on ink" },
    "dark-line": { "value": "#3A342C", "role": "borders on ink" },
    "dark-callout": { "value": "#3A2E14", "role": "marigold-bordered callout on ink" }
  },
  "agents": {
    "@mia/muse-shopper": { "color": "#5B6CF0", "emoji": "🛍️", "name": "Mia's Muse" },
    "@marigold/concierge": { "color": "#F2A33A", "emoji": "🌼", "name": "Concierge" },
    "@marigold/pricing-critic": { "color": "#D96B4A", "emoji": "🧮", "name": "Pricing Critic" },
    "@marigold/inventory": { "color": "#6E8B6B", "emoji": "📦", "name": "Inventory" },
    "@marigold/scout": { "color": "#3F7D9C", "emoji": "🔭", "name": "Scout" },
    "@marigold/bundler": { "color": "#9B6BB5", "emoji": "🎁", "name": "Bundler" },
    "@bo": { "color": "#1F1B16", "emoji": "👤", "name": "Bo (owner)" }
  },
  "sponsors": {
    "Band": "#1F1B16", "ZooWork": "#6E8B6B", "ZooData": "#6E8B6B", "TinyFish": "#3F7D9C",
    "Moss": "#9B6BB5", "Butlr": "#D96B4A", "Stripe(test)": "#5B6CF0", "Novita": "#5B6CF0", "Entire": "#8A8178"
  },
  "font": {
    "display": { "family": "Fraunces", "fallback": "\"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif", "office": "Cambria", "settings": "\"opsz\" 144, \"SOFT\" 60" },
    "body": { "family": "Inter", "fallback": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif", "office": "Calibri" },
    "mono": { "family": "JetBrains Mono", "fallback": "ui-monospace, SFMono-Regular, Menlo, monospace", "office": "Courier New" },
    "google": "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,400..800,0..100&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
  },
  "type-scale-px": { "hero": [56, 72], "h2": [30, 36], "h3": [18, 20], "body": [15, 16], "small": [12, 13], "mono-label": [10, 11] },
  "radius": { "card": "1.25rem", "card-lg": "1.5rem", "pill": "999px", "chip": "0.375rem", "phone": "2.2rem" },
  "space": { "base": 4, "section-desktop": 80, "section-mobile": 48, "card": 20, "gutter-mobile": 16 },
  "shadow": { "card": "0 1px 0 rgba(31,27,22,.04), 0 8px 24px -12px rgba(31,27,22,.18)" },
  "motion": {
    "pop-in": "320ms cubic-bezier(.2,.8,.2,1)",
    "count-up": "420ms ease-out",
    "pulse-ring": "1.4s ease-out infinite",
    "reduced-motion": "disable all"
  },
  "badges": { "live": { "label": "Live · Band", "color": "#2F8F5B" }, "replay": { "label": "Replay", "color": "#3F7D9C" } }
}
